# ============================================================
# VELONA BACKEND — Environment Variables
# Copy this file to .env and fill in your values
# ⚠️  NEVER commit .env to git
# ============================================================

# Server
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Supabase (service role — server only)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create in Stripe Dashboard > Products)
STRIPE_STARTER_INDIVIDUAL_MONTHLY_PRICE_ID=price_...
STRIPE_STARTER_INDIVIDUAL_ANNUAL_PRICE_ID=price_...
STRIPE_STARTER_PROFESSIONAL_MONTHLY_PRICE_ID=price_...
STRIPE_STARTER_PROFESSIONAL_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_INDIVIDUAL_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_INDIVIDUAL_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_PROFESSIONAL_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_PROFESSIONAL_ANNUAL_PRICE_ID=price_...
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_...
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=price_...

# ── PayPal ────────────────────────────────────────────────
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# PayPal Plan IDs (create in PayPal Dashboard > Subscriptions)
PAYPAL_PLAN_STARTER_INDIVIDUAL=P-...
PAYPAL_PLAN_STARTER_PROFESSIONAL=P-...
PAYPAL_PLAN_PRO_INDIVIDUAL=P-...
PAYPAL_PLAN_PRO_PROFESSIONAL=P-...
PAYPAL_PLAN_ENTERPRISE=P-...

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================================
# VELONA WEB — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key (Project Settings > API > service_role) — server-side only,
# required by the booking system's public API routes (/api/bookings/*)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend (transactional emails for the booking system)
RESEND_API_KEY=your_resend_api_key

# Stripe (public key for frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
